rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function obraEditavel(obraId) {
      let obra = get(/databases/$(database)/documents/obras/$(obraId)).data;
      return obra.ownerId == request.auth.uid
        && !obra.get('lockedByPlan', false)
        && !obra.get('lockedByAdmin', false)
        && !obra.get('arquivada', false)
        && !(obra.get('deletionStatus', '') in ['pending', 'processing']);
    }

    function diarioEditavel(obraId, diarioId) {
      let diario = get(/databases/$(database)/documents/obras/$(obraId)/diarios/$(diarioId)).data;
      return diario.ownerId == request.auth.uid
        && !diario.get('lockedByAdmin', false)
        && diario.get('deletionStatus', '') != 'processing';
    }

    // Plano do usuario: escrito SOMENTE pelo servidor (service account).
    match /planos/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Consumo de IA: escrito SOMENTE pelo servidor; o dono pode ler o proprio.
    match /uso_ia/{docId} {
      allow read: if isSignedIn() && docId.matches('^' + request.auth.uid + '_.*$');
      allow write: if false;
    }

    // Perfil do usuario (vinculo Telegram). O cliente NAO pode escrever
    // campos de controle de uso/plano (iaUso legado, plano) -> anti-burla.
    match /usuarios/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['iaUso', 'plano']);
    }

    // Obras: cada usuario le e escreve apenas as proprias.
    // A checagem em list (resource nulo) permite a query filtrada por ownerId.
    match /obras/{obraId} {
      allow read: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid
        && !request.resource.data.keys().hasAny(['lockedByPlan', 'lockedByAdmin', 'planLockReason', 'planLockedAt', 'deletionStatus']);
      allow update: if isSignedIn() && obraEditavel(obraId)
        && request.resource.data.ownerId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'arquivada', 'lockedByPlan', 'lockedByAdmin', 'planLockReason', 'planLockedAt', 'deletionStatus']);
      allow delete: if false;

      match /diarios/{diarioId} {
        allow read: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
        allow create: if isSignedIn() && obraEditavel(obraId)
          && request.resource.data.ownerId == request.auth.uid
          && !request.resource.data.keys().hasAny(['lockedByAdmin', 'deletionStatus']);
        allow update: if isSignedIn() && obraEditavel(obraId) && diarioEditavel(obraId, diarioId)
          && request.resource.data.ownerId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'obraId', 'lockedByAdmin', 'deletionStatus']);
        allow delete: if false;

        match /fotos/{fotoId} {
          allow read: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
          allow create: if isSignedIn() && obraEditavel(obraId) && diarioEditavel(obraId, diarioId)
            && request.resource.data.ownerId == request.auth.uid;
          allow update, delete: if false;
        }
      }
    }
  }
}

