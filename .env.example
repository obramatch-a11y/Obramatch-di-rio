# TELEGRAM_BOT_TOKEN=
# TELEGRAM_SECRET=
# FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_DB_ID=
# FIREBASE_WEB_API_KEY=   (chave web; restringir por domínio no Google Cloud)
